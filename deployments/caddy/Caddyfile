{$DOMAIN} {
	encode zstd gzip

	# Метрики слушают отдельный внутренний порт (METRICS_ADDR), сюда не
	# проксируются; блок оставлен как страховка от старых конфигураций.
	handle /metrics {
		respond 404
	}

	reverse_proxy app:8080 {
		health_uri /healthz
	}

	log {
		output stdout
		format json
	}
}
