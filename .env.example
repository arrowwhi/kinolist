# ---- Приложение ----
APP_ENV=local# local | prod — определяет формат логов (text | json)
LOG_LEVEL=debug# debug | info | warn | error
SHUTDOWN_TIMEOUT=15s# предельное время graceful shutdown

# ---- HTTP ----
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_HANDLER_TIMEOUT=25s# таймаут на обработку одного запроса (middleware)
PUBLIC_URL=https://example.com# публичный HTTPS-адрес: нужен для Mini App и webhook

# ---- PostgreSQL ----
POSTGRES_DSN=                  # секрет, значения по умолчанию нет
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2
POSTGRES_MAX_CONN_LIFETIME=1h
POSTGRES_MAX_CONN_IDLE_TIME=30m
POSTGRES_HEALTH_CHECK_PERIOD=1m

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=            # секрет
TELEGRAM_MODE=polling# polling | webhook
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=       # секрет, обязателен при TELEGRAM_MODE=webhook
TELEGRAM_POLL_TIMEOUT=30s

# ---- Воркер обогащения ----
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL=2s
WORKER_JOB_TIMEOUT=60s
WORKER_MAX_ATTEMPTS=3

# ---- TMDB ----
TMDB_API_KEY=                  # секрет
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_LANGUAGE=ru-RU
TMDB_TIMEOUT=10s
TMDB_CACHE_TTL=24h

# ---- Кинопоиск (неофициальный API, фолбэк) ----
KINOPOISK_API_KEY=             # секрет; пусто — источник отключён
KINOPOISK_BASE_URL=https://kinopoiskapiunofficial.tech
KINOPOISK_TIMEOUT=10s

# ---- Instagram scraper ----
INSTAGRAM_API_KEY=             # секрет; пусто — работает только добавление по названию
INSTAGRAM_BASE_URL=
INSTAGRAM_TIMEOUT=30s

# ---- LLM (извлечение названия из подписи) ----
LLM_API_KEY=                   # секрет
LLM_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT=30s
